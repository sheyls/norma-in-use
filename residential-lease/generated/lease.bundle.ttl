@prefix : <https://example.org/lease-en#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gap: <https://example.org/norma-gap#> .
@prefix norma: <https://w3id.org/def/norma-o#> .
@prefix normad: <https://w3id.org/def/norma-o/deriv#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:c_anniversary a norma:LegalCondition ;
    norma:conditionStatement "A year of the agreement is completed, the agreement has been extended and three years have not yet passed." ;
    norma:hasTrigger :te_anniversary .

:c_appliance a norma:LegalCondition ;
    norma:conditionStatement "A household appliance has broken down through use." ;
    norma:hasTrigger :te_appliance .

:c_breach a norma:LegalCondition ;
    norma:conditionStatement "The tenant has breached the agreement." ;
    norma:hasTrigger :te_breach .

:c_breach_late a norma:LegalCondition ;
    norma:conditionStatement "The tenant is in breach because of a delay in paying the rent (clause 10)." ;
    norma:hasTrigger :te_breach_costs,
        :te_breach_sue .

:c_damage_attributed a norma:LegalCondition ;
    norma:conditionStatement "The tenant answers for damage caused by an occupant (clause 11)." ;
    norma:hasTrigger :te_damage_attributed .

:c_damage_end a norma:LegalCondition ;
    norma:conditionStatement "On termination, the dwelling, the furniture or its services show damage caused during the lease." ;
    norma:hasTrigger :te_damage_deposit,
        :te_damage_pay .

:c_expiry a norma:LegalCondition ;
    norma:conditionStatement "The expiry date of the agreement or of one of its extensions arrives." ;
    norma:hasTrigger :te_expiry .

:c_improvements_end a norma:LegalCondition ;
    norma:conditionStatement "The agreement has ended and the tenant had made authorised alterations or improvements." ;
    norma:hasTrigger :te_improvements_end .

:c_incident a norma:LegalCondition ;
    norma:conditionStatement "An incident affecting the property occurs." ;
    norma:hasTrigger :te_incident .

:c_misuse a norma:LegalCondition ;
    norma:conditionStatement "A minor breakdown, breakage or damage is shown to be due to improper use of the installations." ;
    norma:hasTrigger :te_misuse .

:c_no_renewal a norma:LegalCondition ;
    norma:conditionStatement "The tenant has notified the landlord of her wish not to renew, at least thirty days before expiry." ;
    norma:hasTrigger :te_no_renewal .

:c_no_renewal_late a norma:LegalCondition ;
    norma:conditionStatement "The tenant has notified her wish not to renew less than thirty days before expiry." ;
    norma:hasTrigger :te_no_renewal_late,
        :te_penalty .

:c_no_supply a norma:LegalCondition ;
    norma:conditionStatement "The water or electricity supply fails." ;
    norma:hasTrigger :te_no_supply .

:c_notice_L a norma:LegalCondition ;
    norma:conditionStatement "The landlord has given reliable written notice of termination thirty days before the end of an extension." ;
    norma:hasTrigger :te_notice_L .

:c_notice_T a norma:LegalCondition ;
    norma:conditionStatement "The tenant has given reliable written notice of termination thirty days before the end of an extension." ;
    norma:hasTrigger :te_notice_T .

:c_occupant_damage a norma:LegalCondition ;
    norma:conditionStatement "An occupant of the dwelling (not the tenant) has caused damage to the landlord." ;
    norma:hasTrigger :te_occupant_damage .

:c_own_damage a norma:LegalCondition ;
    norma:conditionStatement "The tenant has caused damage to the landlord." ;
    norma:hasTrigger :te_own_damage .

:c_pet a norma:LegalCondition ;
    norma:conditionStatement "The tenant keeps a domestic animal in the dwelling." ;
    norma:hasTrigger :te_pet .

:c_pet_damage a norma:LegalCondition ;
    norma:conditionStatement "The domestic animal has caused damage to the dwelling." ;
    norma:hasTrigger :te_pet_damage .

:c_signature a norma:LegalCondition ;
    norma:conditionStatement "The agreement is signed." ;
    norma:hasTrigger :te_signature .

:c_signs_auth a norma:LegalCondition ;
    norma:conditionStatement "The landlord has authorised a sign or advertisement." ;
    norma:hasTrigger :te_signs_auth .

:c_sublet a norma:LegalCondition ;
    norma:conditionStatement "The tenant sublets the smallest room." ;
    norma:hasTrigger :te_sublet_inform .

:c_terminated a norma:LegalCondition ;
    norma:conditionStatement "The agreement has ended." ;
    norma:hasTrigger :te_keys,
        :te_refund_deposit,
        :te_return_dwelling,
        :te_term_expiry,
        :te_term_withdrawal .

:c_under5 a norma:LegalCondition ;
    norma:conditionStatement "On the expiry date, the lease has not reached a duration of five years." ;
    norma:hasTrigger :te_under5 .

:c_unpaid a norma:LegalCondition ;
    norma:conditionStatement "The first six days of the month have passed without the tenant paying the rent." ;
    norma:hasTrigger :te_unpaid_late,
        :te_unpaid_sue .

:c_withdrawal a norma:LegalCondition ;
    norma:conditionStatement "After at least six months, the tenant gives notice that she withdraws from the agreement." ;
    norma:hasTrigger :te_withdrawal .

:c_withdrawal_1y a norma:LegalCondition ;
    norma:conditionStatement "The withdrawal takes place before one year of the agreement has elapsed." ;
    norma:hasTrigger :te_withdrawal_1y .

:c_works_auth a norma:LegalCondition ;
    norma:conditionStatement "The landlord has authorised works in writing." ;
    norma:hasTrigger :te_works_auth .

:g01 a gap:Gap ;
    gap:category "conflict with mandatory law" ;
    gap:missing "The landlord's notice at the end of each annual extension clashes with the compulsory extension of art. 9.1 LAU, which only the tenant can avoid (the landlord is a natural person and the agreement reserves no need under art. 9.3). Void under art. 6 LAU; the graph, which holds only the agreement, lets it end the agreement (case L06)." ;
    gap:representedAs :FCT_5_notice_L ;
    gap:section "5" .

:g02 a gap:Gap ;
    gap:category "conflict with mandatory law" ;
    gap:missing "At five years the agreement does not simply end: art. 10 LAU imposes a tacit extension if neither party gives notice (four months for the landlord, two for the tenant), and Royal Decree-Law 28/2026 rewrites it from 15 November 2026. The graph, which holds only the agreement, ends it (case L14)." ;
    gap:representedAs :FCT_4_expiry ;
    gap:section "4" .

:g03 a gap:Gap ;
    gap:category "conflict with mandatory law" ;
    gap:missing "Exempting the landlord from all liability for lack of supplies clashes with her duty to keep the dwelling habitable (art. 21 LAU) insofar as the failure depends on her. It is also an immunity (second order), which NORMA-O does not represent." ;
    gap:representedAs :FCT_6_exemption ;
    gap:section "6" .

:g04 a gap:Gap ;
    gap:category "conflict with mandatory law (variant)" ;
    gap:missing "Compensation for withdrawal was valid under the former art. 11 LAU (one month's rent per remaining year, pro rata); art. 11.3 LAU as worded by RDL 29/2026 excludes it. Whether the new wording reaches an agreement of June 2026 is a question of transitional law: represented by variant-lau-2026.ttl." ;
    gap:representedAs :O_4_compensation ;
    gap:section "4" .

:g05 a gap:Gap ;
    gap:category "conflict with mandatory law" ;
    gap:missing "Court costs are decided by the judge (art. 394 of the Civil Procedure Act) and the costs of formalising the agreement fall on the landlord (art. 20.1 LAU); the clause puts both on the tenant. The graph applies it as written." ;
    gap:representedAs :O_12_costs ;
    gap:section "12" .

:g06 a gap:Gap ;
    gap:category "conflict with mandatory law" ;
    gap:missing "Setting 'the term' by agreement after three years cannot reduce the five-year minimum of art. 9.1 LAU, and rent updates remain capped by art. 18 LAU." ;
    gap:representedAs :FCT_3_after3 ;
    gap:section "3" .

:g07 a gap:Gap ;
    gap:category "penalty clause" ;
    gap:missing "The penalty for giving less than thirty days' notice withdraws the whole deposit (which is one month's rent). The law attaches no sanction to that notice; the validity and moderation of the penalty (art. 1154 Civil Code) are left out." ;
    gap:representedAs :FCT_4_penalty ;
    gap:section "4" .

:g08 a gap:Gap ;
    gap:category "potestative condition" ;
    gap:missing "The deposit is returned once the agreement is fulfilled 'to the landlord's satisfaction': performance is left to one party's discretion (art. 1256 Civil Code). The graph does not evaluate satisfaction; the deposit is returned on termination unless the penalty applies." ;
    gap:representedAs :O_10_refund ;
    gap:section "10" .

:g09 a gap:Gap ;
    gap:category "vague standard" ;
    gap:missing "'Break down through use' does not distinguish ordinary wear (small repairs borne by the tenant, art. 21.4 LAU) from replacing an appliance at the end of its useful life, which falls on the landlord." ;
    gap:representedAs :O_6_repair ;
    gap:section "6" .

:g10 a gap:Gap ;
    gap:category "implied consent" ;
    gap:missing "A partial sublease needs the landlord's written consent (art. 8.2 LAU); the clause presupposes it for the smallest room and is read as consent given in advance. The data it requires (payslip, employment contract) raise a data-protection question that is left out." ;
    gap:representedAs :P_7_sublet ;
    gap:section "7" .

:g11 a gap:Gap ;
    gap:category "redundancy" ;
    gap:missing "The tenant's notice of termination (clause 5) and her notice of non-renewal (clause 4) are the same faculty with the same period; the graph has them as two exceptions to the extension." ;
    gap:representedAs :FCT_5_notice_T ;
    gap:section "4, 5" .

:g12 a gap:Gap ;
    gap:category "plurality of tenants" ;
    gap:missing "There are two tenants and the agreement does not say whether they are jointly or jointly and severally liable. NORMA-O addresses duties to the role, so each duty reaches both tenants in full: a joint-and-several reading that the text does not state." ;
    gap:section "Parties" .

:g13 a gap:Gap ;
    gap:category "implied withdrawal" ;
    gap:missing "The agreement sets a six-month minimum and regulates compensation, but states neither the withdrawal nor its thirty-day notice (art. 11.1 LAU)." ;
    gap:representedAs :FCT_4_withdrawal ;
    gap:section "4" .

:g14 a gap:Gap ;
    gap:category "external source" ;
    gap:missing "Submission to the LAU and the Civil Code refers to provisions that are not in the graph." ;
    gap:representedAs :FCT_1_governing ;
    gap:section "1" .

:g15 a gap:Gap ;
    gap:category "statement of fact" ;
    gap:missing "Statements of fact by the landlord; NORMA-O has no class for them nor for the consequence of their being false." ;
    gap:representedAs :FCT_R1_ownership,
        :FCT_R2_habitability ;
    gap:section "Recitals I and II" .

:g16 a gap:Gap ;
    gap:category "object of the agreement" ;
    gap:missing "The object and the inventory delimit what the norms bear on; no action links them to the goods of the inventory." ;
    gap:representedAs :FCT_2_object,
        :FCT_R3_use ;
    gap:section "Recital III, 2" .

:g17 a gap:Gap ;
    gap:category "quantitative effect" ;
    gap:missing "The calculation of the updated rent with the IRAV index is not represented." ;
    gap:representedAs :P_3_update ;
    gap:section "3" .

:g18 a gap:Gap ;
    gap:category "duration" ;
    gap:missing "Dates and periods; the conditions read them as facts of the case, they are not computed." ;
    gap:representedAs :FCT_4_minimum,
        :FCT_4_term ;
    gap:section "4" .

:g19 a gap:Gap ;
    gap:category "statement of fact" ;
    gap:missing "Condition of the dwelling at handover: the benchmark of the duty to return it in the same condition, which the graph does not compare." ;
    gap:representedAs :FCT_6_handover ;
    gap:section "6" .

:g20 a gap:Gap ;
    gap:category "property right" ;
    gap:missing "Improvements reverting to the landlord without compensation is a proprietary effect, with no conduct to regulate." ;
    gap:representedAs :FCT_8_improvements ;
    gap:section "8" .

:g21 a gap:Gap ;
    gap:category "forum" ;
    gap:missing "Submission to the courts of the place of the dwelling; NORMA-O has no notion of jurisdiction." ;
    gap:representedAs :FCT_14_forum ;
    gap:section "14" .

