<https://example.org/lease-en/lease> a owl:Ontology ;
    rdfs:label "Residential lease agreement (Spain, 2026, anonymised, English translation) in NORMA-O 2.0"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:seeAlso <https://github.com/sheyls/NORMA-O> ;
    owl:imports <https://w3id.org/def/norma-o/2.0>,
        <https://w3id.org/def/norma-o/deriv/1.0> .

:Expr_en a norma:LegalSourceExpression ;
    rdfs:label "English translation (anonymised): lease-en-translation.txt"@en ;
    dcterms:language "en" .

:Expr_es a norma:LegalSourceExpression ;
    rdfs:label "Spanish original (anonymised), authoritative: lease-es-original.txt"@en ;
    dcterms:language "es" .

:te_anniversary a norma:TriggerEvent ;
    norma:activatesNorm :P_3_update ;
    norma:hasOutcome norma:TrueOutcome .

:te_appliance a norma:TriggerEvent ;
    norma:activatesNorm :O_6_repair ;
    norma:hasOutcome norma:TrueOutcome .

:te_breach a norma:TriggerEvent ;
    norma:activatesNorm :O_12_costs ;
    norma:hasOutcome norma:TrueOutcome .

:te_misuse a norma:TriggerEvent ;
    norma:activatesNorm :O_8_minor_repairs ;
    norma:hasOutcome norma:TrueOutcome .

:te_notice_T a norma:TriggerEvent ;
    norma:activatesNorm :FCT_5_notice_T ;
    norma:hasOutcome norma:TrueOutcome .

:te_own_damage a norma:TriggerEvent ;
    norma:activatesNorm :O_11_damages ;
    norma:hasOutcome norma:TrueOutcome .

:te_signs_auth a norma:TriggerEvent ;
    norma:activatesNorm :FCT_7_signs_auth ;
    norma:hasOutcome norma:TrueOutcome .

:F_10_offset_claim_a_offset_deposit_neg_landlord a norma:Claim ;
    norma:hasPositionHolder :landlord ;
    norma:isCorrelativeOf :F_10_offset_duty_a_offset_deposit_neg .

:F_10_offset_duty_a_offset_deposit_neg a norma:Duty ;
    rdfs:label "duty concerning a_offset_deposit_neg"@en ;
